# Edge: TLS termination (Let's Encrypt via Cloudflare DNS-01), visitor-IP
# recovery from Cloudflare, security headers, then on to Varnish.
{
	email support@stagecoach.sh
	acme_dns cloudflare {env.CF_API_TOKEN}
	admin off

	servers {
		# Only Cloudflare's addresses may tell us who the visitor is.
		trusted_proxies static {$CF_IP_RANGES}
		client_ip_headers Cf-Connecting-Ip
	}
}

(cloudflare_only) {
	# Belt and braces with the NetworkPolicy: drop anything not from Cloudflare.
	@direct not remote_ip {$CF_IP_RANGES}
	abort @direct
}

stagecoach.sh {
	import cloudflare_only

	# Cache invalidation is internal-only.
	@purge method PURGE BAN
	respond @purge 405

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy varnish.stagecoach.svc.cluster.local:80 {
		# Hand Drupal the real visitor IP, not Cloudflare's.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}

	log {
		output stdout
		format json
	}
}

# The stagecoach.sh agent API, for customers' clusters. Only /v1/agent/*,
# /v1/clusters and /v1/clusters/* are public, all behind tenant tokens: agents
# register, report and (serve -relay) fetch relayed requests; the stage_coach
# module lists its token's clusters at /v1/clusters and sends hosted-deploy
# requests (CI its releases) to /v1/clusters/<id>/api/*. /v1/tenants takes the
# portal's token, which acts on any tenant, and /api runs operations on this
# cluster — neither ever leaves it.
api.stagecoach.sh {
	import cloudflare_only

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@agent path /v1/agent/* /v1/clusters /v1/clusters/*
	handle @agent {
		# Relayed answers (history, releases) can run to megabytes; Go caps
		# every endpoint's body itself.
		request_body {
			max_size 8MB
		}
		reverse_proxy stage-coach.stage-coach.svc.cluster.local:8080 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}
	handle {
		header Content-Type application/json
		respond `{"error":{"code":"not_found","message":"not an agent API path"}}` 404
	}

	log {
		output stdout
		format json
	}
}

# Helm chart repository: helm repo add stagecoach https://charts.stagecoach.sh
charts.stagecoach.sh {
	import cloudflare_only

	header {
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "public, max-age=300"
		-Server
	}
	root * /srv/charts
	file_server
}

www.stagecoach.sh {
	import cloudflare_only
	redir https://stagecoach.sh{uri} permanent
}

# Kubernetes probes (not exposed outside the pod network).
http://:8081 {
	respond /healthz "ok" 200
}
